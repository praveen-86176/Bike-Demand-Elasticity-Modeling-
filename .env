# ============================================================
#  Bike Demand Elasticity — Environment Variables
#  Local macOS PostgreSQL@15 with dedicated bikeuser
# ============================================================

# ── Full async DSN (asyncpg driver) ───────────────────────────
DATABASE_URL=postgresql+asyncpg://bikeuser:bike1234@localhost:5432/bikedb

# ── Individual fields (fallback) ──────────────────────────────
DB_USER=bikeuser
DB_PASSWORD=bike1234
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bikedb

# ── Model artefact storage ─────────────────────────────────────
MODEL_DIR=./saved_models

# ── API settings ───────────────────────────────────────────────
APP_ENV=development
DEBUG=false
